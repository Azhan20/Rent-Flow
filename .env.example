# Application server
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL (private connection string; use TLS in production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=false

# Firebase web app settings (public identifiers, still restrict API key in Google Cloud)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Firebase Admin: prefer workload identity / ADC in production.
# For local service-account auth, either set all three values below or provide
# FIREBASE_SERVICE_ACCOUNT_JSON as a single-line secret in the host secret store.
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_CLIENT_EMAIL=service-account@YOUR_PROJECT_ID.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREDACTED\n-----END PRIVATE KEY-----\n"
# Optional alternative to the two values above. Store only in a local/host secret manager.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Gemini server-side key. Never use a VITE_ prefix for private keys.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional public Google Maps browser key (restrict by referrer and API).
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
